# Database Mode: Chạy trực tiếp MongoDB (mongodb://localhost:27017/quanlytaichinh)
USE_JSON_DB=false

# MongoDB Connection URI
MONGODB_URI=mongodb://127.0.0.1:27017/quanlytaichinh

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=supersecretrandomstringmin32charslong!finance123

# Google OAuth (Tùy chọn)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend API Key (Gửi email nhắc hạn)
RESEND_API_KEY=re_123456789

# Cron Secret (Bảo vệ API route /api/cron/reminders)
CRON_SECRET=super_secret_cron_token_2026

